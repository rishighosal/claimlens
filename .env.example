# Hindsight Cloud: https://ui.hindsight.vectorize.io  (promo code MEMHACK99 in Billing)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
CLAIMLENS_BANK_ID=claimlens-siu

# Any OpenAI-compatible endpoint. Groq: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Backups tried in order (comma-separated). Check yours: python scripts/check_llm.py
LLM_FALLBACK_MODEL=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Seconds to wait out a rate limit before trying the next model
LLM_RATE_LIMIT_WAIT=60

# Minimum reranker relevance (0-1) for a "similar story" link
CLAIMLENS_NARRATIVE_MIN_RERANK=0.55

# Offline UI development only (naive stand-ins, not Hindsight)
CLAIMLENS_FAKE_MEMORY=0
CLAIMLENS_FAKE_LLM=0
